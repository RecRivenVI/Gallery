{
  "packages": {
    "alpha": {
      "cel_expressions": [],
      "cel_profile_version": "gallery-cel-v1",
      "compiler_requirement": "gallery-rule-compiler-v1",
      "extensions": {},
      "normalization_algorithm_version": "gallery-canonical-json-v1",
      "parameter_schema": {
        "additionalProperties": false,
        "type": "object"
      },
      "primitives": [
        {
          "id": "work",
          "kind": "path_match",
          "config": {
            "glob": "*/*",
            "metadata_file": "metadata.json",
            "scope": "work_directory",
            "stable_key": "relative_path",
            "title": "directory_name"
          }
        },
        {
          "id": "title",
          "kind": "fallback",
          "config": {
            "pointers": [
              "/title/text",
              "/title"
            ],
            "target": "title"
          }
        },
        {
          "id": "creator",
          "kind": "fallback",
          "config": {
            "pointers": [
              "/user/name"
            ],
            "target": "creator"
          }
        },
        {
          "id": "description",
          "kind": "fallback",
          "config": {
            "pointers": [
              "/caption",
              "/text"
            ],
            "target": "description"
          }
        },
        {
          "id": "source-url",
          "kind": "fallback",
          "config": {
            "pointers": [
              "/postUrl",
              "/url"
            ],
            "target": "source_url"
          }
        },
        {
          "id": "tags",
          "kind": "fallback",
          "config": {
            "pointers": [
              "/tags"
            ],
            "target": "tags"
          }
        },
        {
          "id": "path-segments",
          "kind": "path_capture",
          "config": {
            "pattern": "^(?P\u003cauthor\u003e[^/]+)/(?P\u003cwork\u003e[^/]+)$",
            "targets": {
              "creator": "author"
            }
          }
        },
        {
          "id": "creator-id",
          "kind": "stable_key",
          "config": {
            "pointer": "/user/id",
            "target": "creator"
          }
        },
        {
          "id": "work-date",
          "kind": "work_date",
          "config": {
            "input_timezone": "UTC",
            "path_pattern": "/(?P\u003cyear\u003e\\d{4})-(?P\u003cmonth\u003e\\d{2})-(?P\u003cday\u003e\\d{2})_(?P\u003chour\u003e\\d{2})-(?P\u003cminute\u003e\\d{2})-(?P\u003csecond\u003e\\d{2})_",
            "path_timezone": "Asia/Tokyo",
            "pointers": [
              "/date"
            ]
          }
        },
        {
          "id": "media-gif",
          "kind": "media_classify",
          "config": {
            "glob": "*.gif",
            "kind": "image",
            "mime": "image/gif"
          }
        },
        {
          "id": "media-jpg",
          "kind": "media_classify",
          "config": {
            "glob": "*.jpg",
            "kind": "image",
            "mime": "image/jpeg"
          }
        },
        {
          "id": "media-mp4",
          "kind": "media_classify",
          "config": {
            "glob": "*.mp4",
            "kind": "video",
            "mime": "video/mp4"
          }
        },
        {
          "id": "media-png",
          "kind": "media_classify",
          "config": {
            "glob": "*.png",
            "kind": "image",
            "mime": "image/png"
          }
        },
        {
          "id": "hidden",
          "kind": "media_hidden",
          "config": {
            "globs": [
              ".*",
              "cover.*",
              ".cover.*"
            ]
          }
        },
        {
          "id": "nocover",
          "kind": "cover_disable_marker",
          "config": {
            "filename": ".nocover"
          }
        },
        {
          "id": "cover-0",
          "kind": "cover_candidate",
          "config": {
            "glob": "cover.*",
            "priority": 100
          }
        },
        {
          "id": "cover-1",
          "kind": "cover_candidate",
          "config": {
            "glob": ".cover.*",
            "priority": 100
          }
        },
        {
