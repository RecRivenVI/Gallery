          "config": {
            "badge_id": "r18",
            "label": "R-18",
            "order": 1,
            "position": "cover_top_left",
            "style": {
              "background": "#773333",
              "border": "#9b4a4a",
              "color": "#ffffff"
            },
            "when": {
              "tags": [
                "R-18"
              ]
            }
          }
        },
        {
          "id": "badge-ai",
